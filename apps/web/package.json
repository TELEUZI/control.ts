{
  "name": "@control.ts/movie-app",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "tsx server/start.ts",
    "build": "tsc && vite build",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr server/entry-server.ts --outDir dist/server",
    "build:server-runner": "tsc -p tsconfig.server.json",
    "build:static": "npm run build:prod && cross-env NODE_ENV=production node dist/server-runner/build-static.js",
    "build:ssr": "npm run build:client && npm run build:server",
    "build:prod": "npm run build:client && npm run build:server && npm run build:server-runner",
    "preview": "vite preview",
    "preview:ssr": "cross-env NODE_ENV=production tsx server/start.ts",
    "start": "cross-env NODE_ENV=production node dist/server-runner/start.js",
    "prepare": "husky",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src"
  },
  "dependencies": {
    "@control.ts/control": "workspace:*",
    "@control.ts/signals": "workspace:*",
    "@control.ts/router": "workspace:*",
    "@control.ts/ssr": "workspace:*",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "sass": "^1.79.4",
    "sirv": "^2.0.4",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.22.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
